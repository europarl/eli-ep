ta:Work-TA a sh:NodeShape;
  owl:versionInfo "2.5.0";
  rdfs:comment "This node shape represents a subset of eli:Work"@en;
  sh:target ta:Work-TA-target;
  skos:example "https://data.europarl.europa.eu/eli/dl/doc/TA-9-2021-0362";
  sh:nodeKind sh:IRI;
  sh:node shacl-ep:Work-TA-Node;
  sh:closed "true"^^xsd:boolean;
  sh:ignoredProperties _:552e4c547ad34c33a489630ab4d6c1131198;
  sh:order "1"^^xsd:integer;
  rdfs:label "Adopted text"@en;
  sh:property ta:Work-TA_type, ta:Work-TA_identifier, ta:Work-TA_work_type, ta:Work-TA_date_document,
    ta:Work-TA_identifierYear, ta:Work-TA_title, ta:Work-TA_label, ta:Work-TA_epNumber,
    ta:Work-TA_notation, ta:Work-TA_parliamentary_term, ta:Work-TA_is_about, ta:Work-TA_publisher,
    ta:Work-TA_creator, ta:Work-TA_is_realized_by, ta:Work-TA_isAboutSubjectMatter, ta:Work-TA_isAboutDirectoryCode,
    ta:Work-TA_adopts, ta:Work-TA_inversePath_corrects, ta:Work-TA_inversePath_refers_to,
    ta:Work-TA_inversePath_created_a_realization_of, ta:Work-TA_inversePath_decided_on_a_realization_of,
    ta:Work-TA_inversePath_is_annex_of, ta:Work-TA_inversePath_answers_to .

ta:Work-TA-target sh:select """PREFIX eli: <http://data.europa.eu/eli/ontology#>
SELECT ?this
WHERE {
 ?this eli:work_type <https://data.europarl.europa.eu/def/ep-document-types/TEXT_ADOPTED>.
}""" .

